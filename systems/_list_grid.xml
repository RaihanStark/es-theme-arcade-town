<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <image name="list_selector_bg" extra="true">
      <visible>false</visible>
    </image>

    <!-- Original vector console logos for every system -->
    <image name="logo">
      <path>./_inc/logos/_default.png</path>
      <path>./_inc/logos/${system.theme}.png</path>
      <path>./_inc/logos/${system.theme}.svg</path>
    </image>

    <!-- 2-Column Original Console Logo Grid on the left pane -->
    <imagegrid name="imagegrid">
      <pos>0.044 0.120</pos>
      <size>0.295 0.765</size>
      <origin>0 0</origin>
      <scrollDirection>vertical</scrollDirection>
      <autoLayout>2 4</autoLayout>
      <autoLayoutSelectedZoom>1.05</autoLayoutSelectedZoom>
      <margin>0.012 0.012</margin>
      <padding>0.008 0.008 0.008 0.008</padding>
      <animateSelection>false</animateSelection>
      <zIndex>20</zIndex>
    </imagegrid>

    <gridtile name="default">
      <backgroundImage>./_inc/frames/tile_frame.png</backgroundImage>
      <backgroundCornerSize>6 6</backgroundCornerSize>
      <backgroundColor>FFFFFF</backgroundColor>
      <padding>8 8</padding>
      <imageColor>4A527A</imageColor>
      <imageSizeMode>maxSize</imageSizeMode>
    </gridtile>

    <gridtile name="selected">
      <backgroundImage>./_inc/frames/tile_frame_sel.png</backgroundImage>
      <backgroundCornerSize>8 8</backgroundCornerSize>
      <backgroundColor>FFFFFF</backgroundColor>
      <padding>8 8</padding>
      <imageColor>1E2448</imageColor>
    </gridtile>

    <image name="gridtile.image">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.5</pos>
      <maxSize>0.78 0.72</maxSize>
    </image>

    <!-- Hide text label so only the clean centered original logo shows -->
    <text name="gridtile.text">
      <visible>false</visible>
    </text>
  </view>
</theme>
