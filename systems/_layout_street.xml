<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <image name="background" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <path>${frameDir}/bg_system_street.png</path>
      <linearSmooth>false</linearSmooth>
      <zIndex>1</zIndex>
    </image>

    <!-- 3-Shop Horizontal Street Carousel -->
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.09</pos>
      <size>1 0.59</size>
      <origin>0 0</origin>
      <color>00000000</color>
      <logoScale>1.32</logoScale>
      <logoSize>0.34 0.42</logoSize>
      <maxLogoCount>3</maxLogoCount>
      <scrollSound>./_inc/sounds/scroll.wav</scrollSound>
      <zIndex>10</zIndex>
    </carousel>

    <image name="logo">
      <path>./art/shops/default.png</path>
      <path>./art/shops/${system.theme}.png</path>
      <linearSmooth>false</linearSmooth>
    </image>

    <text name="logoText">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${inkNavy}</color>
      <forceUppercase>1</forceUppercase>
    </text>

    <image name="shop_portrait" extra="true">
      <path>./_inc/portraits/default.png</path>
      <path>./_inc/portraits/${system.theme}.png</path>
      <pos>0.0625 0.788</pos>
      <size>0.0875 0.135</size>
      <origin>0 0</origin>
      <linearSmooth>false</linearSmooth>
      <zIndex>20</zIndex>
    </image>

    <text name="shop_nameplate" extra="true">
      <text>${system.fullName}</text>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.027</fontSize>
      <color>${inkNavy}</color>
      <pos>0.047 0.696</pos>
      <size>0.22 0.05</size>
      <alignment>left</alignment>
      <zIndex>25</zIndex>
    </text>

    <text name="shop_dialogue" extra="true">
      <text>Hello! Welcome to the ${system.fullName} shop. Browse the shelves and press A to play!</text>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${inkNavy}</color>
      <pos>0.178 0.782</pos>
      <size>0.755 0.145</size>
      <alignment>left</alignment>
      <lineSpacing>1.18</lineSpacing>
      <zIndex>25</zIndex>
    </text>

    <text name="systemInfo">
      <pos>0.64 0.015</pos>
      <size>0.32 0.045</size>
      <backgroundColor>00000000</backgroundColor>
      <color>${inkMuted}</color>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.024</fontSize>
      <alignment>right</alignment>
      <zIndex>25</zIndex>
    </text>

    <helpsystem name="help">
      <pos>0.035 0.016</pos>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.024</fontSize>
      <textColor>${inkMuted}</textColor>
      <iconColor>${accentTeal}</iconColor>
      <zIndex>25</zIndex>
    </helpsystem>
  </view>
</theme>
