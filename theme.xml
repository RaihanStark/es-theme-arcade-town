<?xml version="1.0" encoding="UTF-8"?>
<!--
  es-theme-arcade-town
  Cozy Pixel-Art RPG Town theme for ArkOS / EmulationStation (640x480 4:3 R36S)
  Font: PeaberryBase (exact PortMaster Patching Shop font)
  Supports two System View layouts selectable in ArkOS UI Settings:
    - Split Directory (default): 6 systems visible on left + shop & dialogue on right
    - Town Street: 3 shops visible side-by-side along a cozy street
-->
<theme>
  <formatVersion>7</formatVersion>

  <variables>
    <fontMain>./_inc/fonts/PeaberryBase.ttf</fontMain>
    <fontTitle>./_inc/fonts/PeaberryBase.ttf</fontTitle>
  </variables>

  <!-- ==================== COLOR SCHEME (DAY / NIGHT) ==================== -->
  <subset name="colorscheme" displayName="Color Scheme">
    <include name="day" displayName="Daylight Cream">./systems/_color_day.xml</include>
    <include name="night" displayName="Midnight Arcade (Dark)">./systems/_color_night.xml</include>
  </subset>

  <!-- ==================== SPLASH / LOADING VIEW ==================== -->
  <view name="splash">
    <splash name="splash">
      <backgroundColor>${bgCanvas}</backgroundColor>
    </splash>

    <image name="background">
      <path>${frameDir}/splash_bg.png</path>
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <linearSmooth>false</linearSmooth>
    </image>

    <text name="label">
      <pos>0 0.775</pos>
      <size>1 0.055</size>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.030</fontSize>
      <color>${inkNavy}</color>
      <alignment>center</alignment>
    </text>

    <image name="progressbar">
      <pos>0.22 0.85</pos>
      <size>0.56 0.034</size>
      <color>${paperFill}</color>
      <colorEnd>${paperFill}</colorEnd>
    </image>

    <image name="progressbar:active">
      <pos>0.22 0.85</pos>
      <size>0.56 0.034</size>
      <color>${accentCoral}</color>
      <colorEnd>F29FA3</colorEnd>
    </image>
  </view>

  <!-- ==================== SCREEN OVERLAY (CLOCK, BATTERY, WI-FI) ==================== -->
  <view name="screen">
    <text name="clock">
      <origin>1 0.5</origin>
      <pos>0.975 0.030</pos>
      <size>0.16 0.05</size>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${inkNavy}</color>
      <alignment>right</alignment>
      <zIndex>200</zIndex>
    </text>

    <!-- Hide legacy batteryIndicator (hardcodes default sans font for %) -->
    <batteryIndicator name="batteryIndicator">
      <visible>false</visible>
    </batteryIndicator>

    <!-- Native themeable Battery % in PeaberryBase font -->
    <batteryText name="bat_pct" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.855 0.056</pos>
      <size>0.06 0.025</size>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.016</fontSize>
      <color>${inkNavy}</color>
      <alignment>center</alignment>
      <zIndex>200</zIndex>
    </batteryText>

    <batteryIcon name="bat_ico" extra="true">
      <origin>1 0.5</origin>
      <pos>0.877 0.034</pos>
      <maxSize>0.044 0.034</maxSize>
      <color>${inkNavy}</color>
      <full>./_inc/icons/battery_full.svg</full>
      <at75>./_inc/icons/battery_75.svg</at75>
      <at50>./_inc/icons/battery_50.svg</at50>
      <at25>./_inc/icons/battery_25.svg</at25>
      <empty>./_inc/icons/battery_empty.svg</empty>
      <incharge>./_inc/icons/battery_charging.svg</incharge>
      <zIndex>200</zIndex>
    </batteryIcon>

    <networkIcon name="net_ico" extra="true">
      <origin>1 0.5</origin>
      <pos>0.821 0.034</pos>
      <maxSize>0.040 0.034</maxSize>
      <color>${inkNavy}</color>
      <networkIcon>./_inc/icons/wifi.svg</networkIcon>
      <zIndex>200</zIndex>
    </networkIcon>

    <controllerActivity name="controllerActivity">
      <visible>false</visible>
    </controllerActivity>
  </view>

  <!-- ==================== MENU VIEW ==================== -->
  <view name="menu">
    <menuBackground name="menubg">
      <path>${frameDir}/menu_frame_9patch.png</path>
      <cornerSize>16 16</cornerSize>
      <color>FFFFFF</color>
      <scrollbarColor>${menuScroll}</scrollbarColor>
    </menuBackground>

    <menuGrid name="menugrid">
      <separatorColor>${menuSep}</separatorColor>
    </menuGrid>

    <menuText name="menutitle">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${inkNavy}</color>
    </menuText>

    <menuText name="menutext">
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.030</fontSize>
      <color>${inkNavy}</color>
      <selectedColor>FAF8F5</selectedColor>
      <selectorColor>${accentCoral}</selectorColor>
      <selectorColorEnd>${accentCoral}</selectorColorEnd>
      <separatorColor>${menuSep}</separatorColor>
    </menuText>

    <menuText name="menugroup">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.024</fontSize>
      <color>${accentTeal}</color>
      <separatorColor>${menuScroll}</separatorColor>
    </menuText>

    <menuTextSmall name="menutextsmall">
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.024</fontSize>
      <color>${inkMuted}</color>
    </menuTextSmall>

    <menuText name="menufooter">
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${inkMuted}</color>
    </menuText>
  </view>

  <!-- ==================== SYSTEM VIEW: BGM + LAYOUT & LEFT LIST SUBSETS ==================== -->
  <view name="system">
    <sound name="directory">
      <path>./_inc/music</path>
    </sound>
  </view>

  <subset name="layout" displayName="System View Layout">
    <include name="split" displayName="RPG Split Directory (Multi-System)">./systems/_layout_split.xml</include>
    <include name="street" displayName="Town Street (3 Shops)">./systems/_layout_street.xml</include>
  </subset>

  <subset name="liststyle" displayName="Left Console List Style">
    <include name="coral" displayName="Coral RPG Bar (Carousel)">./systems/_list_coral.xml</include>
    <include name="grid" displayName="2x4 Pixel Badge Grid">./systems/_list_grid.xml</include>
    <include name="textlist" displayName="Classic RPG Menu List">./systems/_list_textlist.xml</include>
  </subset>

  <!-- ==================== GAMELIST VIEWS (DETAILED / VIDEO / BASIC) ==================== -->
  <view name="detailed, video, basic">
    <image name="background" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <path>${frameDir}/bg_gamelist.png</path>
      <linearSmooth>false</linearSmooth>
      <zIndex>1</zIndex>
    </image>

    <text name="header_title" extra="true">
      <text>${system.fullName}</text>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${inkNavy}</color>
      <pos>0.03 0.014</pos>
      <size>0.65 0.05</size>
      <alignment>left</alignment>
      <forceUppercase>1</forceUppercase>
      <zIndex>20</zIndex>
    </text>

    <textlist name="gamelist">
      <pos>0.045 0.12</pos>
      <size>0.448 0.50</size>
      <origin>0 0</origin>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.032</fontSize>
      <primaryColor>${inkNavy}</primaryColor>
      <secondaryColor>${accentTeal}</secondaryColor>
      <selectedColor>FAF8F5</selectedColor>
      <selectorColor>${accentCoral}</selectorColor>
      <selectorColorEnd>${accentCoral}</selectorColorEnd>
      <selectorImagePath>./_inc/frames/selector.png</selectorImagePath>
      <selectorHeight>0.060</selectorHeight>
      <horizontalMargin>0.03</horizontalMargin>
      <alignment>left</alignment>
      <lineSpacing>1.45</lineSpacing>
      <scrollSound>./_inc/sounds/scroll.wav</scrollSound>
      <zIndex>20</zIndex>
    </textlist>

    <sound name="launch">
      <path>./_inc/sounds/launch.wav</path>
    </sound>
    <sound name="back">
      <path>./_inc/sounds/back.wav</path>
    </sound>
    <sound name="menuOpen">
      <path>./_inc/sounds/select.wav</path>
    </sound>

    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.345</pos>
      <maxSize>0.38 0.41</maxSize>
      <linearSmooth>false</linearSmooth>
      <zIndex>15</zIndex>
    </image>

    <video name="md_video">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.345</pos>
      <maxSize>0.38 0.41</maxSize>
      <delay>1.0</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <zIndex>16</zIndex>
    </video>

    <text name="md_genre">
      <pos>0.60 0.59</pos>
      <size>0.34 0.045</size>
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.025</fontSize>
      <color>${inkMuted}</color>
      <alignment>right</alignment>
      <zIndex>20</zIndex>
    </text>

    <text name="md_description">
      <pos>0.048 0.728</pos>
      <size>0.90 0.165</size>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.031</fontSize>
      <color>${inkNavy}</color>
      <lineSpacing>1.16</lineSpacing>
      <zIndex>20</zIndex>
    </text>

    <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_developer, md_publisher, md_players, md_playcount">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate, md_lastplayed">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>

    <helpsystem name="help">
      <pos>0.035 0.946</pos>
      <fontPath>${fontMain}</fontPath>
      <fontSize>0.027</fontSize>
      <textColor>${inkNavy}</textColor>
      <iconColor>${accentCoral}</iconColor>
      <iconUpDown>./_inc/icons/btn_dpad_ud.svg</iconUpDown>
      <iconLeftRight>./_inc/icons/btn_dpad_lr.svg</iconLeftRight>
      <iconUpDownLeftRight>./_inc/icons/btn_dpad.svg</iconUpDownLeftRight>
      <iconA>./_inc/icons/btn_a.svg</iconA>
      <iconB>./_inc/icons/btn_b.svg</iconB>
      <iconX>./_inc/icons/btn_x.svg</iconX>
      <iconY>./_inc/icons/btn_y.svg</iconY>
      <iconL>./_inc/icons/btn_l.svg</iconL>
      <iconR>./_inc/icons/btn_r.svg</iconR>
      <iconStart>./_inc/icons/btn_start.svg</iconStart>
      <iconSelect>./_inc/icons/btn_select.svg</iconSelect>
      <zIndex>25</zIndex>
    </helpsystem>
  </view>

  <!-- Per-system RPG dialogue & shopkeeper overrides -->
  <include>./systems/${system.theme}.xml</include>
</theme>
